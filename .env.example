# ---------------------------------------------------------------------------
# Bluestaq Notes Service — example configuration
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Environment: development | testing | production
ENVIRONMENT=development
DEBUG=false

# --- Database --------------------------------------------------------------
# SQLite (default, works out of the box)
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///./notes.db

# PostgreSQL (alternative; install `psycopg` — already a dependency)
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql+psycopg://notes:notes@localhost:5432/notes

# --- Authentication --------------------------------------------------------
# Development-only demo identity via the X-Demo-User-ID header.
# MUST be false in production (startup fails otherwise).
AUTH_DEMO_ENABLED=true

# OIDC/JWT (optional). Enable only when issuer, audience, and JWKS URL are set.
AUTH_OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_LEEWAY_SECONDS=30

# --- HTTP security ---------------------------------------------------------
# Comma-separated list. Required (and wildcard-forbidden) in production.
CORS_ALLOW_ORIGINS=
MAX_REQUEST_BODY_BYTES=262144
SECURITY_HEADERS_ENABLED=true

# --- Platform operations (operator-only views) -----------------------------
# Comma-separated `<user-id>:<scope>` grants. Empty means NOBODY, not everybody.
# A grant is narrow: the listed operator may read only the named view, so a
# person who tunes withholding thresholds does not thereby read the platform-wide
# audit sweep. Use `*` as the scope to grant every operational view.
# Entries accumulate, so one operator can hold two scopes on two entries.
# Known scopes: withholding-report, audit-integrity, operator-access-report
# Malformed entries (bare id, empty scope, non-UUID id) fail at startup.
OPS_OPERATOR_USER_IDS=

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Pagination ------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
