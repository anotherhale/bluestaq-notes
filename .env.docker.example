# ---------------------------------------------------------------------------
# Bluestaq Notes — Docker Compose configuration example
#
# Copy to `.env` next to docker-compose.yml and adjust as needed. Every value
# has a working default, so `docker compose up --build` runs with no .env at
# all. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Host ports ------------------------------------------------------------
# Where the services are published on your machine. Change these if a port is
# already taken (e.g. API_PORT=18000). The web UI is the main entry point.
WEB_PORT=8080          # web UI:      http://localhost:8080
API_PORT=8000          # API directly: http://localhost:8000/docs

# --- Container-internal ports ---------------------------------------------
# The ports the services listen on *inside* their containers. You normally do
# not need to change these; they exist so the stack can be re-pointed without
# editing any file. If you change API_INTERNAL_PORT, nginx is updated
# automatically (it proxies to api:<API_INTERNAL_PORT>).
API_INTERNAL_PORT=8000 # uvicorn's listen port inside the api container
WEB_INTERNAL_PORT=80   # nginx's listen port inside the web container

# --- PostgreSQL (the db container) ----------------------------------------
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes
POSTGRES_DB=notes

# --- Application -----------------------------------------------------------
# development keeps the demo identity switcher available; production disables
# demo auth (and requires explicit CORS origins — see the app config).
ENVIRONMENT=development
AUTH_DEMO_ENABLED=true

# Cross-origin allowlist for DIRECT API access (not needed by the bundled web
# UI, which is same-origin through the nginx proxy). Comma-separated.
CORS_ALLOW_ORIGINS=

# --- Rate limiting / logging ----------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
LOG_JSON=true
