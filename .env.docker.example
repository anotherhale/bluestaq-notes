# ---------------------------------------------------------------------------
# Bluestaq Notes — Docker Compose configuration example
#
# Copy to `.env` next to docker-compose.yml and adjust as needed. Every value
# has a working default, so `docker compose up --build` runs with no .env at
# all. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Host ports ------------------------------------------------------------
# Where the services are published on your machine.
WEB_PORT=8080          # web UI:      http://localhost:8080
API_PORT=8000          # API directly: http://localhost:8000/docs

# --- PostgreSQL (the db container) ----------------------------------------
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes
POSTGRES_DB=notes

# --- Application -----------------------------------------------------------
# development keeps the demo identity switcher available; production disables
# demo auth (and requires explicit CORS origins — see the app config).
ENVIRONMENT=development
AUTH_DEMO_ENABLED=true

# Cross-origin allowlist for DIRECT API access (not needed by the bundled web
# UI, which is same-origin through the nginx proxy). Comma-separated.
CORS_ALLOW_ORIGINS=

# --- Rate limiting / logging ----------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
LOG_JSON=true
